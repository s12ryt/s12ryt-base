{
  "name": "s12ryt-base",
  "version": "0.1.0",
  "description": "s12ryt 插件加載器主項目，提供插件運行環境與 Context API",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "bin": {
    "s12ryt-base": "./bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node start.js",
    "dev:cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "tar": "^7.4.4",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
